---
import Layout from '../../layouts/Layout.astro';
import SidePanel from '../../components/SidePanel.astro';
import WeekRail from '../../components/WeekRail.astro';
import DayFocus from '../../components/DayFocus.astro';
import TimerWidget from '../../components/TimerWidget.astro';
import QaIsland from '../../qa/QaIsland';
import { curriculum, findDay, coveredForDay } from '../../data';
import { tablesForDay } from '../../data/schema';
import { site } from '../../data/meta';
import type { GenContextDay } from '../../scripts/llm';

export function getStaticPaths() {
  // 从「周 -> 天」结构展开，week 天然非空，不用 weekOfDay 再找一遍
  return curriculum.flatMap((week) =>
    week.days.map((day) => ({ params: { no: String(day.no) }, props: { day, week } })),
  );
}

const { day, week } = Astro.props;
const dd = String(day.no).padStart(2, '0');
const prev = findDay(day.no - 1);
const next = findDay(day.no + 1);
const pd = (n?: number) => String(n ?? 0).padStart(2, '0');

// 出题与答疑共用的当天上下文（learn/drill/pass/brief/已学范围），浏览器端用，
// 见 scripts/llm.ts 与 qa/（ADR-0003）；答疑 island 直接吃这份结构
const qaDay: GenContextDay = {
  no: day.no,
  title: day.title,
  brief: day.brief,
  learn: day.learn,
  drill: day.drill,
  pass: day.pass,
  weekNo: week.no,
  weekTitle: week.title,
  covered: coveredForDay(day.no),
};
const genContext = [qaDay];
// D01 只建 orders 一张表（其余的随业务逐周上线），结构直接放在这一页，不用跳回总览
const schemaLines = tablesForDay(day.no)
  .map((t) => `${t.name}(${t.columns})${t.note ? `  -- ${t.note}` : ''}`)
  .join('\n');
---

<Layout title={`D${dd} ${day.title} · ${site.title}`} description={`第 ${day.no} 天：${day.title}`}>
  <div class="wrap shell">
    <WeekRail current={week.no} anchorBase="/" />

    <main>
      <nav class="crumbs">
        <a href="/">总览</a>
        <span>/</span>
        <a href={`/week/${week.no}`}>W{week.no} {week.short}</a>
        <span>/</span>
        <span>D {dd}</span>
      </nav>

      <DayFocus day={day} week={week} />

      {
        day.no === 1 && (
          <section class="card pad schema">
            <div class="kicker">今天只建一张表 · orders</div>
            <pre>{schemaLines}</pre>
            <p class="more">
              公司此刻的全部家当就是老板发来的这张订单表，其余 6 张会在后面几周随业务逐张上线（见{' '}
              <a href="/#setup">总览 · 环境与数据集</a>
              ）。字段类型自己定--选类型本身就是今天的功课。
            </p>
          </section>
        )
      }

      <nav class="pager">
        {
          prev ? (
            <a class="btn" href={`/day/${prev.no}`}>
              ← D{pd(prev.no)} {prev.title}
            </a>
          ) : (
            <a class="btn" href={`/week/${week.no}`}>
              ← 返回本周
            </a>
          )
        }
        {
          next ? (
            <a class="btn" href={`/day/${next.no}`}>
              D{pd(next.no)} {next.title}
              {' ->'}
            </a>
          ) : (
            <a class="btn" href="/">
              56 天完结，返回总览{' ->'}
            </a>
          )
        }
      </nav>
    </main>

    {
      /* 天页右栏呈现位：部件 + 信息栏同一个 sticky 容器，部件在上（ADR 0001）。
          hidden 由 timer.ts 按 data-timer-holder 认领后解除 */
    }
    <div class="aside-col">
      <div class="slot" data-timer-holder={day.no} hidden>
        <TimerWidget />
      </div>
      <SidePanel />
    </div>
  </div>

  {/* 答疑 island（issue #7）：client:idle——首屏不用它，闲时再加载 React */}
  <QaIsland client:idle day={qaDay} />

  <script
    type="application/json"
    id="gen-context"
    set:html={JSON.stringify(genContext)}
    is:inline
  />
</Layout>

<style>
  /* 右栏呈现位列：部件与信息栏共用一个 sticky 容器；窄屏（≤1100px）aside 列
     沉到主内容下方，部件随之不可见 -- ADR 0001 已接受，标签页标题兜底 */
  .aside-col {
    grid-area: aside;
    position: sticky;
    top: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    min-width: 0;
  }

  .slot {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: var(--shadow);
  }

  .crumbs {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-family: var(--f-mono);
    font-size: 0.74rem;
    color: var(--ink-3);
  }

  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  /* minmax(0, 1fr)：里面的 pre 不得以 min-content 把主栏撑宽（同 DayFocus） */
  .schema {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .schema .more {
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  @media (max-width: 1100px) {
    .aside-col {
      position: static;
    }
  }
</style>
