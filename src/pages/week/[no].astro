---
import Layout from '../../layouts/Layout.astro';
import SidePanel from '../../components/SidePanel.astro';
import WeekRail from '../../components/WeekRail.astro';
import WeekSection from '../../components/WeekSection.astro';
import { curriculum } from '../../data';
import { site } from '../../data/meta';

export function getStaticPaths() {
  return curriculum.map((week) => ({ params: { no: String(week.no) }, props: { week } }));
}

const { week } = Astro.props;
const no = String(week.no).padStart(2, '0');
const prev = curriculum.find((w) => w.no === week.no - 1);
const next = curriculum.find((w) => w.no === week.no + 1);

// 出题上下文只带本周的天（learn/drill/pass/brief），浏览器直连出题用，见 scripts/llm.ts
const genContext = week.days.map((d) => ({
  no: d.no,
  title: d.title,
  brief: d.brief,
  learn: d.learn,
  drill: d.drill,
  pass: d.pass,
  weekNo: week.no,
  weekTitle: week.title,
}));
---

<Layout title={`W${no} ${week.title} · ${site.title}`} description={`第 ${week.no} 周：${week.goal}`}>
  <div class="wrap shell">
    <WeekRail current={week.no} anchorBase="/" />

    <main>
      <WeekSection week={week} />

      <nav class="pager">
        {
          prev ? (
            <a class="btn" href={`/week/${prev.no}`}>
              ← W{prev.no} {prev.short}
            </a>
          ) : (
            <a class="btn" href="/">
              ← 返回总览
            </a>
          )
        }
        {
          next ? (
            <a class="btn" href={`/week/${next.no}`}>
              W{next.no} {next.short} →
            </a>
          ) : (
            <a class="btn" href="/">
              八周完结，返回总览 →
            </a>
          )
        }
      </nav>
    </main>

    <SidePanel />
  </div>

  <script type="application/json" id="gen-context" set:html={JSON.stringify(genContext)} is:inline />
</Layout>
