---
import { reviewSchedule } from '../data/meta';
---

<section id="review">
  <div class="section-head">
    <div class="kicker">保持不忘</div>
    <h2>复习制度</h2>
    <p>
      每天 15 分钟复盘里，前 8 分钟固定用来做间隔重复。不额外占时间，但决定了第 8 周你还剩下多少。
    </p>
  </div>

  <div class="card">
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr><th>时间点</th><th>做什么</th><th>用时</th></tr>
        </thead>
        <tbody>
          {
            reviewSchedule.map((r) => (
              <tr>
                <td>{r.when}</td>
                <td>{r.what}</td>
                <td>{r.cost}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
