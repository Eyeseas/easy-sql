---
import type { Day, Week } from '../types/curriculum';
import { TAG_LABEL, PHASES } from '../types/curriculum';
import { reviewPlanForDay } from '../data';
import LearnList from './LearnList.astro';
import AnswerFold from './AnswerFold.astro';
import TodayReview from './TodayReview.astro';

interface Props {
  day: Day;
  week: Week;
}

const { day, week } = Astro.props;
const reviewItems = reviewPlanForDay(day.no);
const dd = String(day.no).padStart(2, '0');
const learnLabel = day.learnLabel ?? `学 · ${day.split[0]} min`;
const drillLabel = day.drillLabel ?? `练 · ${day.split[1]} min`;
const totalMin = day.split.reduce((a, b) => a + b, 0);
---

<article class="day focus">
  <header class="f-head">
    <div class="f-top">
      <span class="f-no">DAY {dd}</span>
      <a class="f-week" href={`/week/${week.no}`}>W{week.no} · {week.title}</a>
      {day.tags?.map((t) => <span class={`tag tag-${t}`}>{TAG_LABEL[t]}</span>)}
    </div>

    <h1 class="f-title">{day.title}</h1>

    {day.brief && <p class="f-brief" set:html={day.brief} />}

    <div class="f-bar">
      {
        PHASES.map((p, i) => (
          <div class={`seg s${i}`} style={`flex: ${day.split[i]}`}>
            {p.label} {day.split[i]} min
          </div>
        ))
      }
      <span class="f-total">共 {totalMin} 分钟</span>
    </div>

    <div class="f-actions">
      <button class="btn f-start" data-timer-start={day.no} data-timer-idle={day.no}>
        开始计时 · {PHASES.map((p, i) => `${p.label}${day.split[i]}`).join(' ')}
      </button>

      <label class="f-check">
        <input type="checkbox" data-day={day.no} data-week={week.no} />
        <span>完成这一天</span>
      </label>
    </div>
  </header>

  <div class="f-cols">
    <section class="f-col">
      <h2 class="learn">{learnLabel}</h2>
      <LearnList items={day.learn} variant="full" />
    </section>

    <section class="f-col">
      <h2 class="drill">{drillLabel}</h2>
      <ol>
        {
          day.drill.map((x, i) => (
            <li>
              <div set:html={x} />
              {day.drillAnswers?.[i] && <AnswerFold answer={day.drillAnswers[i]!} />}
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <section class="f-pass">
    <b>过关标准</b>
    <span set:html={day.pass} />
  </section>

  {/* 「盘」段的内容位：排在过关标准之后，与三段时间盒里「盘」排最后的顺序一致 */}
  <TodayReview dayNo={day.no} items={reviewItems} />

  <div class="f-tools">
    <button class="btn" data-generate={day.no}>生成补充练习</button>
    <span class="gen-status" data-gen-status={day.no}></span>
  </div>

  <div class="gen" data-exercises={day.no}></div>

  {
    /* 随堂默写：把当天知识点与今日复盘里的旧知识点混在同一道题里。
       没有复盘项的天（D01–D03）不出这个入口——那时它退化成普通出题 */
    reviewItems.length > 0 && (
      <>
        <div class="f-tools">
          <button class="btn" data-recall={day.no}>
            随堂默写
          </button>
          <span class="gen-status" data-recall-status={day.no} />
        </div>

        <div class="gen" data-recall-list={day.no} />
      </>
    )
  }
</article>

<style>
  /* 这一路 grid 容器都要显式写 minmax(0, 1fr)、grid 项都要 min-width: 0：
     自动最小尺寸等于内容的 min-content，参考答案里 white-space: pre 的 SQL
     最长一行会顺着 .focus → .f-cols → .f-col → ol → li 把主栏顶宽压到右栏上，
     pre 自己的 overflow-x: auto 拦不住 */
  .focus {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 26px;
  }

  /* ---------- 头部 ---------- */

  .f-head {
    display: grid;
    gap: 14px;
    padding: 30px 34px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: var(--shadow);
  }

  .f-top {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .f-no {
    font-family: var(--f-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 4px 9px;
  }

  .f-week {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  .f-week:hover {
    color: var(--accent);
  }

  .f-title {
    font-size: var(--step-4);
    letter-spacing: -0.015em;
  }

  .f-brief {
    margin: 0;
    padding: 12px 16px;
    background: var(--surface-2);
    border-left: 2px solid var(--amber);
    border-radius: 2px;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* 时间盒条：按当天的分钟配比分宽 */
  .f-bar {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .f-bar .seg {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--f-mono);
    font-size: 0.76rem;
    white-space: nowrap;
    padding: 0 10px;
    overflow: hidden;
  }

  .s0 {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .s1 {
    background: var(--surface-2);
    color: var(--ink-2);
  }

  .s2 {
    background: var(--amber-soft);
    color: var(--amber);
  }

  .f-total {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .f-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .f-start {
    color: var(--accent);
    border-color: var(--accent);
  }

  .f-check {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--ink-2);
    width: max-content;
  }

  .f-check input {
    appearance: none;
    -webkit-appearance: none;
    width: 17px;
    height: 17px;
    border: 1.5px solid var(--ink-3);
    border-radius: 2px;
    cursor: pointer;
    background: transparent;
    position: relative;
  }

  .f-check input:hover {
    border-color: var(--accent);
  }

  .f-check input:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  .f-check input:checked::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid var(--surface);
    border-width: 0 1.6px 1.6px 0;
    transform: rotate(45deg);
  }

  /* ---------- 学 / 练 ---------- */

  /* 学/练 上下排布 */
  .f-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 26px;
    align-items: start;
  }

  .f-col {
    min-width: 0;
    padding: 24px 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: var(--shadow);
  }

  .f-col h2 {
    font-family: var(--f-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-soft);
  }

  .f-col h2.learn {
    color: var(--accent);
  }

  .f-col h2.drill {
    color: var(--amber);
  }

  .f-col ol {
    margin: 0;
    padding-left: 1.25em;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .f-col ol li {
    min-width: 0;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.75;
  }

  .f-col ol li::marker {
    color: var(--ink-3);
    font-family: var(--f-mono);
    font-size: 0.8em;
  }

  /* 折叠参考答案（默认收起，卡住 8 分钟再点开）的标记与样式都在 AnswerFold 里，
     天页「练」栏与「今日复盘」共用 */

  /* ---------- 过关 / 工具 ---------- */

  .f-pass {
    background: var(--surface);
    border: 1px solid var(--green);
    border-radius: 3px;
    padding: 16px 22px;
    font-size: 0.95rem;
    color: var(--ink-2);
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  .f-pass b {
    color: var(--green);
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .f-tools {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn.is-active {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 勾选完成后的划线；progress.ts 在最近的 .day 上加 is-done，选择器要跨作用域 */
  :global(.day.is-done) .f-title {
    opacity: 0.45;
    text-decoration: line-through;
    text-decoration-color: var(--ink-3);
  }

  :global(.day.is-done) .f-cols,
  :global(.day.is-done) .f-pass {
    opacity: 0.55;
  }

  @media (max-width: 900px) {
    .f-head {
      padding: 20px 18px;
    }

    .f-col {
      padding: 18px;
    }

    .f-bar {
      flex-wrap: wrap;
    }
  }
</style>
