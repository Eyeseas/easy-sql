---
import type { DrillAnswer } from '../types/curriculum';
import { highlightSql } from '../utils/highlightSql';

/**
 * 折叠的参考答案：一句话要点 + 可直接运行的 SQL。
 * 天页「练」栏与「今日复盘」共用同一份标记——两处都是「先自己写，卡住再点开」。
 * 类名全部是全局的（base.css）：到期的错题项由 review.ts 注入，拿不到组件作用域。
 */
interface Props {
  answer: DrillAnswer;
  /** 折叠标题，默认「参考答案」 */
  label?: string;
}

const { answer, label = '参考答案' } = Astro.props;
---

<details class="fold fold-label ans-fold">
  <summary>{label}</summary>
  {answer.note && <p class="ans-note">{answer.note}</p>}
  {answer.sql && <pre class="ans-sql sql-code" set:html={highlightSql(answer.sql)} />}
</details>
