---
import TimerWidget from './TimerWidget.astro';

/**
 * 兜底横条：进行中的计时会话不属于当前页面时的全局底部呈现位（ADR 0001）。
 * 运行态内容直接复用运行位部件（TimerWidget）-- 全站只有一份计时器内容结构，
 * 这里只保留固定定位外壳与完课提示（一次性的全局提醒，不属于兜底横条职责）。
 */
---

<div class="bar" data-timer-bar hidden>
  <div class="wrap inner">
    <TimerWidget />
  </div>
</div>

<div class="done" data-timer-finished hidden>
  <div class="wrap inner">
    <span>今天的 2 小时跑完了 -- 对照过关标准自查了吗？</span>
    <div class="ctrl">
      <button class="btn" data-action="mark-done">标记完成</button>
      <button class="btn" data-action="dismiss">还没</button>
    </div>
  </div>
</div>

<style>
  .bar,
  .done {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: var(--surface);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 24px -20px rgba(0, 0, 0, 0.6);
  }

  .done {
    bottom: 0;
    background: var(--green-soft);
    border-top-color: var(--green);
  }

  .inner {
    display: flex;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .done .inner {
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--green);
    gap: 10px;
  }

  .done .ctrl {
    display: flex;
    gap: 8px;
  }

  @media (max-width: 700px) {
    .done .inner {
      flex-wrap: wrap;
    }
  }
</style>
