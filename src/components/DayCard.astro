---
import type { Day } from '../types/curriculum';
import { TAG_LABEL, PHASES } from '../types/curriculum';
import LearnList from './LearnList.astro';

interface Props {
  day: Day;
  weekNo: number;
}

const { day, weekNo } = Astro.props;
const dd = String(day.no).padStart(2, '0');
const learnLabel = day.learnLabel ?? `学 · ${day.split[0]} min`;
const drillLabel = day.drillLabel ?? `练 · ${day.split[1]} min`;
---

<div class="day">
  <label class="head">
    <input type="checkbox" data-day={day.no} data-week={weekNo} />
    <span class="no">D {dd}</span>
    <span class="title">
      {day.title}
      {day.tags?.map((t) => <span class={`tag tag-${t}`}>{TAG_LABEL[t]}</span>)}
    </span>
    <span class="split">{day.split.join(' / ')}</span>
  </label>

  <div class="detail">
    {
      day.brief && (
        <div class="brief">
          <>
            <b>剧情</b>
            <span set:html={day.brief} />
          </>
        </div>
      )
    }

    <div>
      <div class="col-h learn">{learnLabel}</div>
      <LearnList items={day.learn} />
    </div>

    <div>
      <div class="col-h drill">{drillLabel}</div>
      <ol>{day.drill.map((x) => <li set:html={x} />)}</ol>
    </div>

    <div class="pass"><b>过关</b><span set:html={day.pass} /></div>

    <div class="tools">
      <a class="btn" href={`/day/${day.no}`}>专注视图{' ->'}</a>
      <button class="btn" data-timer-start={day.no}>
        开始今天 · {PHASES.map((p, i) => `${p.label}${day.split[i]}`).join(' ')}
      </button>
      <button class="btn" data-generate={day.no}>生成补充练习</button>
      <span class="gen-status" data-gen-status={day.no}></span>
    </div>

    <div class="gen" data-exercises={day.no}></div>
  </div>
</div>

<style>
  .day {
    padding: 21px 26px;
    border-top: 1px solid var(--line-soft);
  }

  .day:first-child {
    border-top: 0;
  }

  .head {
    display: grid;
    grid-template-columns: 26px 60px minmax(0, 1fr) 96px;
    gap: 16px;
    align-items: start;
    cursor: pointer;
  }

  input {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin: 5px 0 0;
    border: 1.5px solid var(--ink-3);
    border-radius: 2px;
    cursor: pointer;
    background: transparent;
    position: relative;
  }

  input:hover {
    border-color: var(--accent);
  }

  input:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  input:checked::after {
    content: '';
    position: absolute;
    left: 4.5px;
    top: 1.5px;
    width: 4px;
    height: 8px;
    border: solid var(--surface);
    border-width: 0 1.6px 1.6px 0;
    transform: rotate(45deg);
  }

  .no {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--ink-3);
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-weight: 600;
    font-size: 1.04rem;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 1px;
  }

  .split {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: right;
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
    white-space: nowrap;
  }

  .detail {
    margin: 14px 0 6px 102px;
    padding-left: 18px;
    border-left: 2px solid var(--line-soft);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 10px 28px;
  }

  .col-h {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .col-h.learn {
    color: var(--accent);
  }

  .col-h.drill {
    color: var(--amber);
  }

  .detail ol {
    margin: 0;
    padding-left: 1.15em;
    display: grid;
    gap: 8px;
  }

  .detail li {
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .detail li::marker {
    color: var(--ink-3);
    font-family: var(--f-mono);
    font-size: 0.78em;
  }

  .brief {
    grid-column: 1 / -1;
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 10px 14px;
    background: var(--surface-2);
    border-left: 2px solid var(--amber);
    border-radius: 2px;
    font-size: 0.87rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .brief b {
    color: var(--amber);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pass {
    grid-column: 1 / -1;
    margin-top: 16px;
    background: var(--surface-2);
    border-radius: 2px;
    padding: 11px 15px;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .pass b {
    color: var(--ink);
    font-weight: 600;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-right: 8px;
  }

  .tools {
    grid-column: 1 / -1;
    margin-top: 16px;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .gen-status {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .gen {
    grid-column: 1 / -1;
  }

  /* 下面两条由 JS 在 body / .day 上加类触发，选择器要跨出组件作用域 */
  :global(body.is-compact) .detail {
    display: none;
  }

  :global(.day.is-done) .title {
    opacity: 0.42;
    text-decoration: line-through;
    text-decoration-color: var(--ink-3);
  }

  :global(.day.is-done) .detail {
    opacity: 0.5;
  }

  .btn.is-active {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 900px) {
    .day {
      padding: 17px 16px;
    }

    .head {
      grid-template-columns: 24px 48px minmax(0, 1fr);
      gap: 10px;
    }

    .split {
      grid-column: 2 / -1;
      text-align: left;
      padding-top: 4px;
    }

    .detail {
      margin-left: 0;
      grid-template-columns: 1fr;
      gap: 18px;
      padding-left: 14px;
    }
  }
</style>
