---
import type { ReviewItem } from '../scripts/reviewCore';
import { ACTION_LABEL } from '../scripts/reviewCore';
import AnswerFold from './AnswerFold.astro';

/**
 * 「今日复盘」：三段时间盒里「盘」那一段的内容位。
 * 题面直接露出、答案折叠——先自己回忆再对答案，这一段的价值全在主动回忆上。
 *
 * 这里渲染的是固定间隔的那几格（服务端就能算出来）；到期的错题项由 review.ts
 * 在浏览器里补进同一个 <ol>，所以项一级的类名全在 base.css 里，不用作用域样式。
 * 固定格为空时整块仍要渲染——错题可能有，交给客户端决定还留不留。
 */
interface Props {
  dayNo: number;
  items: readonly ReviewItem[];
}

const { dayNo, items } = Astro.props;
const dd = (n: number) => String(n).padStart(2, '0');
/** 练习题折的是参考答案；口头解释折的是易错点，讲完拿它自查 */
const foldLabel = (action: ReviewItem['action']) => (action === 'explain' ? '易错点' : '参考答案');
---

<section class="f-review" data-review-day={dayNo} hidden={items.length === 0}>
  <h2>今日复盘</h2>

  <ol class="rv-list" data-review-list>
    {
      items.map((it) => (
        <li data-review-item={it.id}>
          <div class="rv-meta">
            <span class="rv-origin">D+{it.origin}</span>
            <span class="rv-act">{ACTION_LABEL[it.action]}</span>
            <a class="rv-from" href={`/day/${it.fromDay}`}>
              D{dd(it.fromDay)} {it.fromTitle}
            </a>
          </div>

          <div class="rv-prompt" set:html={it.prompt} />

          {it.answer && <AnswerFold answer={it.answer} label={foldLabel(it.action)} />}

          <div class="rv-judge">
            <button class="btn" data-verdict="known" type="button">
              记得
            </button>
            <button class="btn" data-verdict="forgot" type="button">
              忘了
            </button>
            <span class="rv-said" />
          </div>
        </li>
      ))
    }
  </ol>

  {/* 错题本：内容全在浏览器里，由 review.ts 填。没有错题时整块由脚本收起 */}
  <details class="fold fold-label rv-book" data-review-book hidden>
    <summary>错题本 <span class="rv-book-count" data-review-book-count></span></summary>
    <div data-review-book-list></div>
    <div class="rv-book-foot">
      <button class="btn" data-review-book-copy type="button">复制为 Markdown</button>
      <button class="btn" data-review-book-clear type="button">清空复盘记录</button>
      <span class="rv-said" data-review-book-status></span>
    </div>
  </details>
</section>

<style>
  .f-review {
    min-width: 0;
    padding: 24px 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: var(--shadow);
  }

  .f-review[hidden] {
    display: none;
  }

  /* 与「学」「练」两栏同一种栏头，配色跟着时间盒里的「盘」段走 */
  .f-review h2 {
    font-family: var(--f-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-soft);
  }

  /* 勾选完成后跟着「学 / 练 / 过关」一起压暗；progress.ts 在最近的 .day 上加 is-done */
  :global(.day.is-done) .f-review {
    opacity: 0.55;
  }

  @media (max-width: 900px) {
    .f-review {
      padding: 18px;
    }
  }
</style>
