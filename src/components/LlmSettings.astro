---
// AI 端点设置弹窗（出题与答疑共用，见 CONTEXT.md）。可被右上「AI 设置」按钮和
// 生成/答疑的引导唤起，具体逻辑在 src/scripts/llmSettings.ts。
---

<div
  class="mask"
  data-llm-dialog
  role="dialog"
  aria-modal="true"
  aria-labelledby="llm-settings-title"
  hidden
>
  <div class="card dlg">
    <h3 id="llm-settings-title">AI 设置</h3>
    <p class="hint">
      配置与 key 只保存在本浏览器。出题和答疑请求会经本站 Worker
      转发到所填端点；本站应用不在服务端持久化这些信息。
    </p>

    <div class="fields">
      <label>
        <span>端点类型</span>
        <select data-llm-field="type">
          <option value="anthropic">Anthropic（/v1/messages）</option>
          <option value="openai">OpenAI 兼容（/chat/completions）</option>
          <option value="codex">Codex / Responses（/v1/responses）</option>
        </select>
      </label>

      <label>
        <span>端点地址</span>
        <input data-llm-field="baseUrl" placeholder="https://api.anthropic.com" />
      </label>

      <label>
        <span>模型</span>
        <input data-llm-field="model" placeholder="claude-opus-5" />
      </label>

      <label>
        <span>思考等级</span>
        <select data-llm-field="reasoning">
          <option value="provider-default">模型默认（不发送推理参数）</option>
        </select>
        <small class="field-note" data-llm-reasoning-note aria-live="polite"></small>
      </label>

      <label>
        <span>API Key</span>
        <input type="password" data-llm-field="apiKey" placeholder="sk-..." autocomplete="off" />
      </label>
    </div>

    <div class="row">
      <button class="btn" data-action="llm-save">保存</button>
      <button class="btn" data-action="llm-clear">清空（回到 .env 默认）</button>
      <button class="btn" data-action="llm-close">关闭</button>
    </div>

    <p class="status" data-llm-status aria-live="polite"></p>
  </div>
</div>

<style>
  .mask {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  /* .mask 设了 display，会压掉 UA 样式表里 [hidden] 的 display:none，必须显式补回来 */
  .mask[hidden] {
    display: none;
  }

  .dlg {
    width: min(480px, 100%);
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    padding: 26px 28px;
    display: grid;
    gap: 16px;
  }

  .hint {
    color: var(--ink-3);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .hint,
  .field-note,
  .status {
    overflow-wrap: anywhere;
  }

  .field-note {
    color: var(--ink-3);
    font-family: var(--f-body);
    font-size: 0.72rem;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .fields {
    display: grid;
    gap: 12px;
  }

  label {
    display: grid;
    gap: 5px;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  input,
  select {
    font-family: var(--f-body);
    font-size: 0.88rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 8px 10px;
  }

  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }

  .row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .status {
    font-family: var(--f-mono);
    font-size: 0.74rem;
    color: var(--green);
    min-height: 1em;
  }

  .status.is-error {
    color: var(--danger);
  }
</style>
