# 生成补充练习用的 LLM 端点。这些是「构建时默认值」，不配也能建站，
# 只是生成按钮会提示先去浏览器里的「出题设置」配置。
#
# 注意：PUBLIC_ 前缀的值会被打进前端产物，任何访问者都能看到。
# 站点如果是公开部署的，这里只填端点地址和模型，key 留空，用页面右上
# 「出题设置」在浏览器里填（存在你自己的 localStorage，不会进产物）。

# 端点类型：anthropic（/v1/messages）或 openai（OpenAI 兼容 /chat/completions）
PUBLIC_LLM_TYPE=anthropic

# 端点地址：
#  - anthropic 官方：https://api.anthropic.com（也支持各种 Anthropic 协议中转）
#  - openai 兼容填到 /v1，如 https://api.openai.com/v1
PUBLIC_LLM_BASE_URL=https://api.anthropic.com

# 模型名
PUBLIC_LLM_MODEL=claude-opus-5

# API key（公开部署请留空）
PUBLIC_LLM_API_KEY=
