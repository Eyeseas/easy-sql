{
  "name": "easy-sql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "八周 SQL 冲刺计划 · PostgreSQL 面试向学习计划站点",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "test": "node --test tests/*.test.ts",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.0.0",
    "prismjs": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.3.0",
    "@types/prismjs": "^1.26.6",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.127.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
